{
  "name": "dsh-wallpaper-engine-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for dsh-wallpaper-engine: the installable DSH plugin and the DSH Windows desktop shell",
  "license": "MIT",
  "scripts": {
    "desktop:install": "pnpm --dir desktop install",
    "desktop:build": "pnpm --dir desktop run build",
    "desktop": "pnpm --dir desktop run start",
    "plugin:pack": "npm pack packages/dsh-wallpaper-engine --pack-destination release"
  }
}
